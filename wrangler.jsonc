{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hnk-trial",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "build": { "command": "pnpm hnk prepare", "watch_dir": "src/routes" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hnk-trial",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
}
